# ----------------------------------------------------------------------------
# Creator Earnings Calculator — example environment
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and MUST NOT be committed. Never share your YouTube API key
# in screenshots, tickets, or public logs.
# ----------------------------------------------------------------------------

# --- Server-only secrets ----------------------------------------------------

# Google Cloud API key with the YouTube Data API v3 enabled.
# Restrict this key to the YouTube Data API v3.
# For a stable self-hosted server, you may also apply an IP-address restriction.
# Do not use an HTTP referrer restriction because requests are made server-to-server.
YOUTUBE_API_KEY=

# --- Public (safe to inline in the client bundle) ---------------------------

# Human-readable product name, used in the header, footer, and metadata.
NEXT_PUBLIC_SITE_NAME="Creator Earnings Calculator"

# Canonical base URL. Used for absolute URLs in metadata, robots.txt,
# sitemap.xml, JSON-LD, and Open Graph tags.
#   - In development the default is fine.
#   - In production this MUST be an absolute URL (validated by Zod).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional server tuning -------------------------------------------------

# Upstream YouTube Data API request timeout in milliseconds.
YOUTUBE_TIMEOUT_MS=8000

# In-process sliding-window rate limit. Applies per client identifier.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Set to `1` only when running behind a proxy that overwrites the
# `X-Forwarded-For` header (for example Vercel, Fly, or Cloudflare).
# When `0`, we ignore that header to prevent spoofing the rate limiter.
TRUST_PROXY=0
